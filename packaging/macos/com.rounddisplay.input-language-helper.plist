<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.rounddisplay.input-language-helper</string>
  <key>ProgramArguments</key>
  <array>
    <string>/Applications/Round Display Helper.app/Contents/MacOS/round-display-helper</string>
  </array>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
